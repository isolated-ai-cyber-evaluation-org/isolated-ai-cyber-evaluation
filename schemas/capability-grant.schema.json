{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/capability-grant.schema.json",
  "title": "Opaque synthetic capability metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "kind",
    "capability_id",
    "engagement_id",
    "target_id",
    "purpose_profile_id",
    "issued_at",
    "expires_at",
    "state"
  ],
  "properties": {
    "api_version": {"const": "cyber-eval.openai/v1"},
    "kind": {"const": "CapabilityGrant"},
    "capability_id": {
      "type": "string",
      "pattern": "^cap_[a-z0-9][a-z0-9-]{2,63}$"
    },
    "engagement_id": {
      "type": "string",
      "pattern": "^eng_[a-z0-9][a-z0-9-]{2,63}$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^tgt_[a-z0-9][a-z0-9-]{2,63}$"
    },
    "purpose_profile_id": {
      "type": "string",
      "pattern": "^profile_[a-z0-9][a-z0-9-]{2,63}$"
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["active", "revoked"]}
  }
}
