{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/finding.schema.json",
  "title": "Security finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "cyber-eval.openai/v1"},
    "kind": {"const": "Finding"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "created_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^find_[a-z0-9][a-z0-9-]{2,63}$"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engagement_id",
        "target_id",
        "execution_id",
        "test_case_id",
        "title",
        "category",
        "severity",
        "confidence",
        "status",
        "evidence_ids",
        "description",
        "remediation",
        "created_by"
      ],
      "properties": {
        "engagement_id": {"type": "string", "pattern": "^eng_[a-z0-9][a-z0-9-]{2,63}$"},
        "target_id": {"type": "string", "pattern": "^tgt_[a-z0-9][a-z0-9-]{2,63}$"},
        "execution_id": {"type": "string", "pattern": "^exe_[a-z0-9][a-z0-9-]{2,63}$"},
        "test_case_id": {"type": "string", "pattern": "^tc_[a-z0-9][a-z0-9-]{2,63}$"},
        "title": {"type": "string", "minLength": 3, "maxLength": 240},
        "category": {"type": "string", "minLength": 2, "maxLength": 120},
        "severity": {"enum": ["informational", "low", "medium", "high", "critical"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["candidate", "evidence-pending", "validated", "rejected", "patch-proposed", "revalidated", "closed", "residual-risk"]},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^ev_[a-z0-9][a-z0-9-]{2,63}$"}
        },
        "description": {"type": "string", "minLength": 10, "maxLength": 10000},
        "remediation": {"type": "string", "minLength": 3, "maxLength": 10000},
        "created_by": {"enum": ["model", "human", "tool"]}
      }
    }
  }
}
