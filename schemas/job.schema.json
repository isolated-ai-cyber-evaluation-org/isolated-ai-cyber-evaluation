{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/job.schema.json",
  "title": "Non-executable evaluation job state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "kind",
    "job_id",
    "engagement_id",
    "scope_generation",
    "scope_digest",
    "policy_digest",
    "state",
    "execution_mode"
  ],
  "properties": {
    "api_version": {"const": "cyber-eval.openai/v1"},
    "kind": {"const": "Job"},
    "job_id": {"type": "string", "pattern": "^job_[a-z0-9][a-z0-9-]{2,63}$"},
    "engagement_id": {"type": "string", "pattern": "^eng_[a-z0-9][a-z0-9-]{2,63}$"},
    "scope_generation": {"type": "integer", "minimum": 1},
    "scope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {
      "enum": [
        "PLANNED",
        "POLICY_CHECK",
        "WAITING_APPROVAL",
        "DENIED",
        "QUEUED",
        "PROVISIONING",
        "RUNNING",
        "COLLECTING",
        "COMPLETED",
        "STOPPING",
        "QUARANTINED",
        "DESTROYED"
      ]
    },
    "execution_mode": {"const": "disabled"}
  }
}
